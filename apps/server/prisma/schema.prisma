generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model book {
  id           String          @id(map: "pk_book") @db.Uuid
  authors      String          @db.VarChar(50)
  cover_type   cover_type_enum
  publisher    String          @db.VarChar(50)
  publish_date DateTime?       @db.Date
  pages        Int?
  language     String?         @db.VarChar(20)
  product      product         @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_book_product")
}

model cart {
  id          String        @id(map: "pk_cart") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id  String        @db.Uuid
  updated_at  DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  total_price Int?
  session     session       @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_session")
  cart_detail cart_detail[]

  @@index([session_id], map: "idx_cart_session_id")
}

model cart_detail {
  cart_id    String  @db.Uuid
  product_id String  @db.Uuid
  quantity   Int?
  cart       cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cd_cart")
  product    product @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cd_product")

  @@id([cart_id, product_id], map: "pk_cart_detail")
  @@index([cart_id], map: "idx_cd_cart_id")
  @@index([product_id], map: "idx_cd_product_id")
}

model cds {
  id           String    @id(map: "pk_cds") @db.Uuid
  artist       String    @db.VarChar(50)
  record_label String    @db.VarChar(30)
  track_count  Int?
  runtime      Int?
  release_date DateTime? @db.Date
  product      product   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cds_product")
}

model dvds {
  id           String         @id(map: "pk_dvds") @db.Uuid
  disc_type    disc_type_enum
  director     String         @db.VarChar(50)
  runtime      Int
  studio       String         @db.VarChar(50)
  language     String         @db.VarChar(20)
  subtitle     String         @db.VarChar(20)
  release_date DateTime?      @db.Date
  product      product        @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_dvds_product")
}

model genre {
  id             String           @id(map: "pk_genre") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(20)
  product_genres product_genres[]
}

model lp {
  id           String    @id(map: "pk_lp") @db.Uuid
  artist       String    @db.VarChar(50)
  record_label String    @db.VarChar(30)
  track_count  Int?
  runtime      Int?
  release_date DateTime? @db.Date
  product      product   @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lp_product")
}

model order_detail {
  id         String  @id(map: "pk_order_detail") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String  @db.Uuid
  product_id String  @db.Uuid
  quantity   Int?
  price      Int?
  orders     orders  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_od_order")
  product    product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_od_product")

  @@index([order_id], map: "idx_od_order_id")
}

model orders {
  id                       String                 @id(map: "pk_orders") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id               String                 @db.Uuid
  recipient_name           String?                @db.VarChar(30)
  phone_num                String?                @db.VarChar(15)
  email                    String?                @db.VarChar(30)
  province                 String?                @db.VarChar(20)
  delivery_address         String?                @db.VarChar(50)
  is_rush_order            Boolean?               @default(false)
  rush_delivery_intruction String?                @db.VarChar(100)
  rush_delivery_time       DateTime?              @db.Timestamptz(6)
  total_price_excl_vat     Int?
  total_price_incl_vat     Int?
  regular_delivery_fee     Int?
  rush_delivery_fee        Int?
  delivery_fee             Int?
  total_amount             Int?
  payment_method           payment_method_enum?
  payment_status           order_status_enum?
  created_at               DateTime               @default(now()) @db.Timestamptz(6)
  updated_at               DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  recipient_name_tsv       Unsupported("tsvector")? 
  order_detail             order_detail[]
  session                  session                @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_session")
  transactions             transactions[]

  @@index([email], map: "idx_orders_email")
  @@index([recipient_name_tsv], map: "idx_orders_recipient_tsv", type: Gin)
  @@index([session_id], map: "idx_orders_session_id")
}

model product {
  id                    String                 @id(map: "pk_product") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String?                @db.VarChar(100)
  product_value         Int?
  price                 Int?
  category              category_enum?
  quantity              Int?
  warehouse_entry_date  DateTime?              @db.Date
  dimensions            String?                @db.VarChar(30)
  barcode               Int?
  image_url             String?                @db.VarChar(100)
  description           String?                @db.VarChar(500)
  weight                Int?
  vat                   Int?                   @default(10)
  support_rush_delivery Boolean?               @default(false)
  title_tsv             Unsupported("tsvector")? 
  book                  book?
  cart_detail           cart_detail[]
  cds                   cds?
  dvds                  dvds?
  lp                    lp?
  order_detail          order_detail[]
  product_genres        product_genres[]
  track                 track[]

  @@index([title_tsv], map: "idx_product_title_tsv", type: Gin)
}

model product_genres {
  product_id String  @db.Uuid
  genre_id   String  @db.Uuid
  genre      genre   @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pg_genre")
  product    product @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pg_product")

  @@id([product_id, genre_id], map: "pk_product_genres")
  @@index([genre_id], map: "idx_pg_genre_id")
  @@index([product_id], map: "idx_pg_product_id")
}

model roles {
  id         String       @id(map: "pk_roles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name_role  role_enum
  role_num   Int?
  user_roles user_roles[]
}

model session {
  id            String   @id(map: "pk_session") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @db.Uuid
  refresh_token String?  @db.VarChar(128)
  device_info   Json?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  expired_at    DateTime @db.Timestamptz(6)
  cart          cart[]
  orders        orders[]
  users         users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_user")

  @@index([user_id], map: "idx_session_user_id")
}

model social_account {
  id                  String   @id(map: "pk_social_account") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String   @db.Uuid
  provider            String?  @db.VarChar(20)
  provider_account_id String?  @db.VarChar(100)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  users               users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sa_user")

  @@index([user_id], map: "idx_sa_user_id")
}

model track {
  id         String  @id(map: "pk_track") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String  @db.Uuid
  song_tile  String? @db.VarChar(50)
  length     Int?
  product    product @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_track_product")
}

model transactions {
  id                 String   @id(map: "pk_transactions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String   @db.Uuid
  transaction_no     String   @db.VarChar(15)
  txn_ref            String   @unique @db.VarChar(100)
  bank_code          String?  @db.VarChar(20)
  bank_trans_no      String?  @db.VarChar(50)
  card_type          String?  @db.VarChar(15)
  order_info         String?  @db.VarChar(255)
  pay_date           String?  @db.VarChar(14)
  transaction_status String?  @db.VarChar(20)
  response_code      String?  @db.VarChar(10)
  customer_name      String?  @db.VarChar(30)
  amount             Int
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  orders             orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_trans_order")

  @@index([order_id], map: "idx_trans_order_id")
}

model user_roles {
  user_id String @db.Uuid
  role_id String @db.Uuid
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ur_role")
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ur_user")

  @@id([user_id, role_id], map: "pk_user_roles")
  @@index([role_id], map: "idx_ur_role_id")
  @@index([user_id], map: "idx_ur_user_id")
}

model users {
  id              String                 @id(map: "pk_users") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullname        String                 @db.VarChar(30)
  date_of_birth   DateTime?              @db.Date
  phone_num       String?                @db.VarChar(20)
  gender          gender_enum?
  status          Boolean?               @default(false)
  avatar_url      String?                @db.VarChar(100)
  email           String?                @unique(map: "idx_users_email") @db.VarChar(50)
  password_hash   String?                @db.VarChar(100)
  created_at      DateTime               @default(now()) @db.Timestamptz(6)
  updated_at      DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  user_search_tsv Unsupported("tsvector")? 
  session         session[]
  social_account  social_account[]
  user_roles      user_roles[]

  @@index([user_search_tsv], map: "idx_users_search_tsv", type: Gin)
}

enum category_enum {
  Book
  DVDs
  LP
  CDs
}

enum cover_type_enum {
  hardcover
  paperback
}

enum disc_type_enum {
  blu_ray @map("blu-ray")
  hd_dvd  @map("hd-dvd")
}

enum gender_enum {
  male
  female
  unknown
}

enum order_status_enum {
  unpaid
  processed
  canceled
  completed
  pending
}

enum payment_method_enum {
  cash
  vnpay
}

enum role_enum {
  Admin
  Product_Manager @map("Product Manager")
  Customer
}

enum user_status_enum {
  Active
  Blocked
}